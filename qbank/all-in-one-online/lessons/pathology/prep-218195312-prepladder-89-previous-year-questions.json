{"subject":"Pathology","sourceTitle":"All In One Online","title":"PrepLadder · 89.Previous Year Questions","deckName":"created by tele @Neet_pg_bot::prep::Qbank::Pathology::89.Previous_Year_Questions","questions":[{"id":"all-in-one-1760436532662","topic":"PrepLadder · 89.Previous Year Questions","number":1,"stem":"Anticoagulant used in the test tube for estimating HbA1c?","options":[{"label":"A","text":"Warfarin"},{"label":"B","text":"Sodium Fluoride"},{"label":"C","text":"EDTA"},{"label":"D","text":"Heparin"}],"answer":"C","answerText":"EDTA","solutionHtml":"f316927771817f809648f5\"&amp;gt;anticoagulant for estimating <strong>HbA1c.</strong>\n<p> </p>\n<p><strong>Vacutainers types</strong></p>\n<p> </p>\n<table cellspacing=\"0\" style=\"border-collapse:collapse; width:624px\">\n<tbody>\n<tr>\n<td style=\"border-bottom:1px solid #000000; border-left:1px solid #000000; border-right:1px solid #000000; border-top:1px solid #000000; vertical-align:top\">\n<p><strong>Colour</strong></p>\n</td>\n<td style=\"border-bottom:1px solid #000000; border-left:1px solid #000000; border-right:1px solid #000000; border-top:1px solid #000000; vertical-align:top\">\n<p><strong>Anti-coagulants</strong></p>\n</td>\n<td style=\"border-bottom:1px solid #000000; border-left:1px solid #000000; border-right:1px solid #000000; border-top:1px solid #000000; vertical-align:top\">\n<p><strong>Uses</strong></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-bottom:1px solid #000000; border-left:1px solid #000000; border-right:1px solid #000000; border-top:1px solid #000000; vertical-align:top\">\n<p><strong>Purple/Lavender </strong></p>\n<p><img alt=\"\" data-author=\"NA\" data-hash=\"\" data-license=\"NA\" data-source=\"NA\" data-tags=\"\" height=\"161\" src=\"images/exp_98_168_1.jpg\" width=\"500\"/></p>\n</td>\n<td style=\"border-bottom:1px solid #000000; border-left:1px solid #000000; border-right:1px solid #000000; border-top:1px solid #000000; vertical-align:top\">\n<p>EDTA (Ca2+ chelating anticoa